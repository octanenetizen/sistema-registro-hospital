package ips;

import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Dimension;
import java.awt.FlowLayout;
import java.awt.Font;
import java.awt.Graphics2D;
import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.Image;
import java.awt.Insets;
import java.awt.image.BufferedImage;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Locale;
import javax.imageio.ImageIO;
import javax.swing.BorderFactory;
import javax.swing.ButtonGroup;
import javax.swing.ImageIcon;
import javax.swing.JButton;
import javax.swing.JFileChooser;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JRadioButton;
import javax.swing.JTextField;
import javax.swing.filechooser.FileNameExtensionFilter;

public class gestionDoctores extends JFrame {
    private JTextField txtId, txtNombres, txtApellidos, txtFechaGrado, txtEspecialidad;
    private JRadioButton rbMasculino, rbFemenino;
    private JLabel lblFoto;
    private ImageIcon fotoActual;
    private File archivoFoto;
    private FileInputStream fis;
    private int longitudBytes;

    public gestionDoctores() {
        setTitle("Gestión de Doctores");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(980, 620);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(12, 12));

        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(Color.WHITE);
        header.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));

        JLabel title = new JLabel("CLINICA SAN FELIPE");
        title.setFont(new Font("Tahoma", Font.PLAIN, 36));
        title.setHorizontalAlignment(JLabel.CENTER);
        header.add(title, BorderLayout.CENTER);

        JLabel icono = new JLabel();
        icono.setIcon(createHospitalIcon(80, 80));
        header.add(icono, BorderLayout.EAST);

        add(header, BorderLayout.NORTH);

        JPanel form = new JPanel(new GridBagLayout());
        form.setBackground(Color.WHITE);
        form.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(200, 200, 200)),
                BorderFactory.createEmptyBorder(20, 20, 20, 20)
        ));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 8, 8, 8);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        txtId = new JTextField(12);
        txtNombres = new JTextField(18);
        txtApellidos = new JTextField(18);
        txtFechaGrado = new JTextField(15);
        txtEspecialidad = new JTextField(18);

        rbMasculino = new JRadioButton("Masculino");
        rbFemenino = new JRadioButton("Femenino");
        ButtonGroup grupoSexo = new ButtonGroup();
        grupoSexo.add(rbMasculino);
        grupoSexo.add(rbFemenino);

        lblFoto = new JLabel();
        fotoActual = createDefaultAvatar(140, 140);
        lblFoto.setIcon(fotoActual);
        lblFoto.setPreferredSize(new Dimension(140, 140));
        lblFoto.setBorder(BorderFactory.createLineBorder(new Color(210, 210, 210)));

        gbc.gridx = 0; gbc.gridy = 0; form.add(new JLabel("Identificación:"), gbc);
        gbc.gridx = 1; form.add(txtId, gbc);
        gbc.gridx = 2; form.add(new JLabel("Especialidad:"), gbc);
        gbc.gridx = 3; form.add(txtEspecialidad, gbc);

        gbc.gridx = 0; gbc.gridy = 1; form.add(new JLabel("Nombres:"), gbc);
        gbc.gridx = 1; form.add(txtNombres, gbc);
        gbc.gridx = 2; form.add(new JLabel("Fecha de grado:"), gbc);
        gbc.gridx = 3; form.add(txtFechaGrado, gbc);

        gbc.gridx = 0; gbc.gridy = 2; form.add(new JLabel("Apellidos:"), gbc);
        gbc.gridx = 1; form.add(txtApellidos, gbc);
        gbc.gridx = 2; form.add(new JLabel("Sexo:"), gbc);
        JPanel sexoPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        sexoPanel.setOpaque(false);
        sexoPanel.add(rbMasculino);
        sexoPanel.add(rbFemenino);
        gbc.gridx = 3; form.add(sexoPanel, gbc);

        gbc.gridx = 4; gbc.gridy = 0; gbc.gridheight = 3; gbc.fill = GridBagConstraints.NONE;
        form.add(lblFoto, gbc);

        JButton btnCargarImagen = new JButton("Cargar imagen");
        btnCargarImagen.setForeground(new Color(51, 102, 255));
        btnCargarImagen.addActionListener(e -> cargarImagen());
        gbc.gridx = 4; gbc.gridy = 3; gbc.gridheight = 1; form.add(btnCargarImagen, gbc);

        add(form, BorderLayout.CENTER);

        JPanel buttons = new JPanel(new FlowLayout(FlowLayout.CENTER, 10, 15));
        buttons.setBackground(Color.WHITE);

        JButton btnGrabar = new JButton("Grabar");
        JButton btnConsultar = new JButton("Consultar");
        JButton btnListar = new JButton("Listar");
        JButton btnLimpiar = new JButton("Limpiar");
        JButton btnSalir = new JButton("Salir");
        JButton btnPacientes = new JButton("Pacientes");

        btnGrabar.addActionListener(e -> grabarDoctor());
        btnConsultar.addActionListener(e -> consultarDoctor());
        btnListar.addActionListener(e -> listarDoctores());
        btnLimpiar.addActionListener(e -> limpiarCampos());
        btnSalir.addActionListener(e -> dispose());
        btnPacientes.addActionListener(e -> abrirPacientes());

        buttons.add(btnGrabar);
        buttons.add(btnConsultar);
        buttons.add(btnListar);
        buttons.add(btnLimpiar);
        buttons.add(btnSalir);
        buttons.add(btnPacientes);

        add(buttons, BorderLayout.SOUTH);
    }

    private void grabarDoctor() {
        String idText = txtId.getText().trim();
        if (idText.isEmpty() || txtNombres.getText().trim().isEmpty() || txtApellidos.getText().trim().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Debe completar los campos obligatorios.");
            return;
        }

        try {
            int id = Integer.parseInt(idText);
            String nombres = txtNombres.getText().trim();
            String apellidos = txtApellidos.getText().trim();
            char sexo = rbMasculino.isSelected() ? 'M' : (rbFemenino.isSelected() ? 'F' : ' ');
            Date fechaGrado = parseFecha(txtFechaGrado.getText());
            String especialidad = txtEspecialidad.getText().trim();
            ImageIcon foto = fotoActual == null ? createDefaultAvatar(140, 140) : fotoActual;

            Doctor doctor = new Doctor(id, nombres, apellidos, sexo, fechaGrado, especialidad, foto);
            DoctorManager.guardar(doctor);
            JOptionPane.showMessageDialog(this, "Doctor guardado correctamente.");
            limpiarCampos();
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "La identificación debe ser numérica.");
        }
    }

    private void consultarDoctor() {
        try {
            int id = Integer.parseInt(txtId.getText().trim());
            Doctor doctor = DoctorManager.buscarPorId(id);
            if (doctor == null) {
                JOptionPane.showMessageDialog(this, "No se encontró el doctor.");
                return;
            }

            txtNombres.setText(doctor.getNombres());
            txtApellidos.setText(doctor.getApellidos());
            txtEspecialidad.setText(doctor.getEspecialidad());
            txtFechaGrado.setText(formatearFecha(doctor.getFechaGrado()));
            if (doctor.getSexo() == 'M') rbMasculino.setSelected(true);
            if (doctor.getSexo() == 'F') rbFemenino.setSelected(true);
            if (doctor.getFoto() != null) {
                fotoActual = doctor.getFoto();
                lblFoto.setIcon(fotoActual);
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Ingrese una identificación válida.");
        }
    }

    private void listarDoctores() {
        if (DoctorManager.listarTodos().isEmpty()) {
            JOptionPane.showMessageDialog(this, "No hay doctores registrados.");
            return;
        }

        StringBuilder sb = new StringBuilder();
        for (Doctor d : DoctorManager.listarTodos()) {
            sb.append("ID: ").append(d.getId())
              .append(" | ").append(d.getNombres()).append(" ").append(d.getApellidos())
              .append(" | Especialidad: ").append(d.getEspecialidad())
              .append("\n");
        }
        JOptionPane.showMessageDialog(this, sb.toString(), "Listado de doctores", JOptionPane.INFORMATION_MESSAGE);
    }

    private void limpiarCampos() {
        txtId.setText("");
        txtNombres.setText("");
        txtApellidos.setText("");
        txtFechaGrado.setText("");
        txtEspecialidad.setText("");
        rbMasculino.setSelected(false);
        rbFemenino.setSelected(false);
        fotoActual = createDefaultAvatar(140, 140);
        lblFoto.setIcon(fotoActual);
    }

    private void abrirPacientes() {
        new gestionPacientes().setVisible(true);
    }

    private void cargarImagen() {
        CargarFoto ventana = new CargarFoto();
        int resultado = ventana.getFileChooser().showOpenDialog(this);
        if (resultado == JFileChooser.APPROVE_OPTION) {
            archivoFoto = ventana.getFileChooser().getSelectedFile();
            try {
                BufferedImage img = ImageIO.read(archivoFoto);
                if (img == null) {
                    JOptionPane.showMessageDialog(this, "El archivo seleccionado no es una imagen válida.");
                    return;
                }
                Image scaled = img.getScaledInstance(140, 140, Image.SCALE_SMOOTH);
                fotoActual = new ImageIcon(scaled);
                lblFoto.setIcon(fotoActual);
                fis = new FileInputStream(archivoFoto);
                longitudBytes = (int) archivoFoto.length();
            } catch (IOException e) {
                JOptionPane.showMessageDialog(this, "Error al cargar la imagen: " + e.getMessage());
            }
        }
    }

    private static Date parseFecha(String valor) {
        if (valor == null || valor.trim().isEmpty()) {
            return new Date();
        }
        try {
            return new SimpleDateFormat("dd/MM/yyyy", Locale.getDefault()).parse(valor);
        } catch (ParseException ex) {
            return new Date();
        }
    }

    private static String formatearFecha(Date fecha) {
        if (fecha == null) {
            return "";
        }
        return new SimpleDateFormat("dd/MM/yyyy", Locale.getDefault()).format(fecha);
    }

    private ImageIcon createDefaultAvatar(int width, int height) {
        BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2d = image.createGraphics();

        g2d.setColor(new Color(77, 164, 230));
        g2d.fillOval(0, 0, width, height);

        g2d.setColor(Color.WHITE);
        g2d.fillOval(width / 4, height / 8, width / 2, height / 2);
        g2d.fillOval(width / 6, (height * 3) / 5, width * 2 / 3, height / 5);

        g2d.setColor(new Color(25, 82, 132));
        g2d.fillRect(width / 2 - 8, 0, 16, height / 2);
        g2d.fillRect(width / 2 - 28, height / 4 - 8, 56, 16);

        g2d.dispose();
        return new ImageIcon(image);
    }

    private ImageIcon createHospitalIcon(int width, int height) {
        BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2d = image.createGraphics();
        g2d.setColor(new Color(58, 111, 195));
        g2d.fillRoundRect(8, 8, width - 16, height - 16, 20, 20);
        g2d.setColor(Color.WHITE);
        g2d.fillRect(width / 2 - 4, height / 3, 8, height / 2);
        g2d.fillRect(width / 3, height / 2 - 4, width / 3, 8);
        g2d.dispose();
        return new ImageIcon(image);
    }
}
